# Writes mylo_git_version.h with `git describe` output, such as "0.4.0-22-g793005a"
# (newest tag, commits since it, commit hash). Runs on every build so the version follows
# new commits and tags, but only rewrites the header when the text changes, so an
# unchanged checkout rebuilds nothing.
#
#   cmake -DGIT_EXECUTABLE=<git> -DSOURCE_DIR=<repo> -DOUTPUT=<header> -P GitVersion.cmake

execute_process(
    COMMAND "${GIT_EXECUTABLE}" describe --tags --always --dirty
    WORKING_DIRECTORY "${SOURCE_DIR}"
    OUTPUT_VARIABLE describe
    OUTPUT_STRIP_TRAILING_WHITESPACE
    RESULT_VARIABLE result
    ERROR_QUIET
)
if(NOT result EQUAL 0)
    # Not a git checkout (for example a source zip), so leave git out of the version.
    set(describe "")
endif()

if(describe)
    set(suffix " (${describe})")
else()
    set(suffix "")
endif()

set(content "// Generated by cmake/GitVersion.cmake on each build. Do not edit.
#define MYLO_GIT_DESCRIBE \"${describe}\"
#define MYLO_GIT_SUFFIX \"${suffix}\"
")

set(existing "")
if(EXISTS "${OUTPUT}")
    file(READ "${OUTPUT}" existing)
endif()
if(NOT existing STREQUAL content)
    file(WRITE "${OUTPUT}" "${content}")
endif()
