import native "pixel_window.mylo"

// Window dimensions
width: i32 = 640
height: i32 = 480

// Initialize PixelWindow
win: i32 = PW::create_window(width, height, "Mylo PixelWindow Demo", false)
buffer: u8[] = PW::create_buffer(width, height)

frame: i32 = 0

forever {
    // Process window events (returns false if user closed the window)
    if (PW::process_events(win) == false) {
        break
    }

    // Check for ESC key
    if (PW::is_key_pressed(win, PW::KEY_ESCAPE)) {
        break
    }

    // Clear buffer to dark background
    PW::clear_buffer(buffer, width, height, 20, 24, 32)

    // Draw grid / shapes using TinyDraw
    PW::draw_line(buffer, width, height, 20, 20, width - 20, 20, 2, 80, 100, 120)
    PW::draw_line(buffer, width, height, 20, height - 20, width - 20, height - 20, 2, 80, 100, 120)

    // Animated circle
    cx: i32 = 120 + (frame % 200)
    PW::draw_circle(buffer, width, height, cx, 160, 40, 2, true, 255, 128, 0)
    PW::draw_circle(buffer, width, height, cx, 160, 48, 2, false, 255, 255, 255)

    // Filled and outlined rectangles
    PW::draw_rect(buffer, width, height, 380, 100, 140, 90, 2, true, 0, 150, 220)
    PW::draw_rect(buffer, width, height, 375, 95, 150, 100, 2, false, 255, 255, 255)

    // Triangle
    PW::draw_triangle(buffer, width, height, 260, 320, 200, 420, 320, 420, 3, true, 40, 200, 80)

    // Text rendering via TinyGlyph
    PW::draw_text(buffer, width, height, "MYLO + PIXELWINDOW", 30, 40, 16, 255, 255, 255)
    PW::draw_text(buffer, width, height, "TinyDraw & TinyGlyph :)", 30, 65, 8, 180, 200, 220)

    // Mouse tracking
    mx: f32 = PW::get_mouse_x(win)
    my: f32 = PW::get_mouse_y(win)
    m_px: i32 = mx * width
    m_py: i32 = my * height

    // Mouse cursor box
    is_down: bool = PW::is_mouse_down(win, 0)
    if (is_down) {
        PW::draw_rect(buffer, width, height, m_px - 8, m_py - 8, 16, 16, 2, true, 255, 50, 50)
    } else {
        PW::draw_rect(buffer, width, height, m_px - 8, m_py - 8, 16, 16, 2, false, 0, 255, 100)
    }

    PW::draw_text(buffer, width, height, f"Mouse: {m_px}, {m_py}", 30, 440, 8, 200, 200, 200)

    // Blit to screen
    PW::update_window(win, buffer)
    frame = frame + 1
}

PW::destroy_window(win)
print("PixelWindow closed cleanly.")
